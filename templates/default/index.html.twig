{% extends 'base.html.twig' %}

{% block title %}{{ 'home.title'|trans }}{% endblock %}

{% block hero %}
    <section class="hero text-center">
        <div class="sunset" aria-hidden="true">
            <span class="sunset-cloud sunset-cloud-1"></span>
            <span class="sunset-cloud sunset-cloud-2"></span>
            <span class="sunset-cloud sunset-cloud-3"></span>
            <span class="sunset-sun"></span>
            <span class="sunset-sea"></span>
            <span class="sunset-glitter"></span>
        </div>
        <div class="container position-relative">
            <h1 id="site-title" class="display-3 fw-bold">Atacames</h1>
            <p class="lead mb-0">{{ 'home.tagline'|trans }}</p>
        </div>
        <svg class="hero-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,40 C240,80 480,0 720,32 C960,64 1200,8 1440,36 L1440,80 L0,80 Z"></path>
        </svg>
    </section>
{% endblock %}

{% block body %}
    {% if app.user %}
        <div class="alert alert-success mt-4">
            <h4 class="mb-0">{{ 'home.welcome'|trans({'%name%': app.user.param('user_name') ?: app.user.userIdentifier}) }}</h4>
            {% if not app.user.param('user_name') %}
                {{ 'home.update_profile'|trans({'%url%': path('app_profile')})|raw }}
            {% endif %}
        </div>
    {% endif %}

    <section id="webcam" class="my-5" aria-labelledby="webcam-title">
        <h2 id="webcam-title" class="section-title">
            <twig:ux:icon name="bi:camera-video-fill" /> {{ 'webcam.title'|trans }}
        </h2>
        <figure class="webcam mb-0">
            <div class="ratio ratio-16x9">
                <img src="{{ webcam_image_url ?: asset('images/webcam.jpg') }}" alt="{{ 'webcam.alt'|trans }}"
                     class="w-100 h-100 object-fit-cover" data-testid="webcam-image">
            </div>
            <span class="webcam-live"><span class="webcam-dot"></span> {{ 'webcam.live'|trans }}</span>
            <figcaption class="webcam-caption">{{ 'webcam.caption'|trans }}</figcaption>
        </figure>
    </section>

    <section id="discover" class="mb-5" aria-labelledby="discover-title">
        <h2 id="discover-title" class="section-title">
            <twig:ux:icon name="bi:compass-fill" /> {{ 'discover.title'|trans }}
        </h2>
        <div class="row g-4">
            {% for card in [
                {key: 'where', icon: 'bi:geo-alt-fill'},
                {key: 'beach', icon: 'bi:water'},
                {key: 'culture', icon: 'bi:music-note-beamed'},
                {key: 'food', icon: 'bi:egg-fried'},
                {key: 'whales', icon: 'bi:binoculars-fill'},
                {key: 'nearby', icon: 'bi:signpost-split-fill'},
            ] %}
                <div class="col-md-6 col-lg-4">
                    <article class="card tropical-card h-100">
                        <div class="card-body">
                            <span class="tropical-icon" aria-hidden="true"><twig:ux:icon name="{{ card.icon }}" /></span>
                            <h3 class="h5 card-title">{{ ('cards.' ~ card.key ~ '.title')|trans }}</h3>
                            <p class="card-text">{{ ('cards.' ~ card.key ~ '.text')|trans }}</p>
                        </div>
                    </article>
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
